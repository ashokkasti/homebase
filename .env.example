# Set false for real use. Demo never calls Coolify.
HOMEBASE_DEMO=true
HOMEBASE_ADMIN_EMAIL=admin@example.com
# Generate with: npm exec tsx scripts/hash-password.ts 'your password'
HOMEBASE_PASSWORD_HASH=
# At least 32 random characters. Required outside demo.
HOMEBASE_SESSION_SECRET=
# 64 hex characters. Required for encrypted setup credentials.
HOMEBASE_ENCRYPTION_KEY=
# Optional: connect via environment instead of the setup screen.
HOMEBASE_COOLIFY_URL=
HOMEBASE_COOLIFY_TOKEN=
HOMEBASE_SERVER_NAME=Home Server
# Optional public origin(s), comma-separated. Only needed if your proxy omits X-Forwarded headers.
HOMEBASE_URL=
# Persistent directory for encrypted credentials, e.g. /app/data
HOMEBASE_DATA_DIR=
# Optional: address of the Coolify host for SSH when the server is "localhost" (containers and terminal).
HOMEBASE_SSH_LOCAL_HOST=
